// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ETUDIANT
  FORMATEUR
  ADMIN
}

enum Niveau {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum Statut {
  EN_COURS
  TERMINE
  ABANDONNE
}

enum StatutDemande {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

//----- MODELES --------

model Utilisateur {
  id       String @id @default(cuid())
  clerkId  String @unique
  email    String @unique
  nom      String
  role     Role   @default(ETUDIANT)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  inscriptions     Inscription[]
  coursPublies     Cours[]
  demandeFormateur DemandeFormateur[]

  quizFaits QuizFait[]
}

model DemandeFormateur {
  id String @id @default(cuid())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  motivation String
  expertise  String
  statut     StatutDemande @default(EN_ATTENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cours {
  id          String @id @default(cuid())
  titre       String
  description String
  niveau      Niveau @default(DEBUTANT)

  formateurId String
  formateur   Utilisateur @relation(fields: [formateurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecons       Lecon[]
  inscriptions Inscription[]

  @@unique([formateurId, titre])
}

model Inscription {
  id          String @id @default(cuid())
  statut      Statut @default(EN_COURS)
  progression Float  @default(0) //en%

  utilisateurId String
  coursId       String

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  cours       Cours       @relation(fields: [coursId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // empêche un étudiant de s'inscrire deux fois au même cours
  @@unique([utilisateurId, coursId])
}

model Lecon {
  id      String @id @default(cuid())
  titre   String
  contenu String
  ordre   Int

  coursId String
  cours   Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)

  quiz Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // titre de leçon doit être unique par cours
  @@unique([coursId, titre])
}

model Quiz {
  id    String @id @default(cuid())
  titre String

  //relier le quiz à sa leçon
  leconId String
  lecon   Lecon  @relation(fields: [leconId], references: [id], onDelete: Cascade)

  questions Question[]

  quizFaits QuizFait[]

}

model QuizFait{
  id    String @id @default(cuid())
  score Float
  bonneReponse    Int
  totalQuestions  Int

  utilisateurId   String
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  quizId    String
  quiz      Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([utilisateurId, quizId])
}

model Question {
  id                String   @id @default(cuid())
  enonce            String
  bonneReponse      String
  mauvaisesReponses String[]

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
